# Fill values in the hosting settings or the private .env. Never upload this as-is.
# Preserve existing values when upgrading.
ADMIN_PASSWORD=
AUTH_TOKEN_SECRET=
ADMIN_TOKEN=
# If encrypted VPN accounts already exist, preserve their ORIGINAL effective key.
COMMERCE_CREDENTIAL_KEY=
# Optional override requires explicit opt-in. Leave unset to preserve legacy connection.
USE_ENV_MONGO_URI=
MONGO_URI=
